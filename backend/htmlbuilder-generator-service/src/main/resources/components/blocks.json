    "html": "<section class='hb-hero'><div class='hb-hero-inner'><span class='hb-hero-badge'>全新发布 · v2.0</span><h1 class='hb-hero-title'>用一句话<br>生成完整网站</h1><p class='hb-hero-sub'>从需求分析到代码落地，AI 全流程自动完成，几分钟上线你的产品主页。</p><div class='hb-hero-actions'><a class='hb-btn hb-btn-primary' href='#'>立即体验</a><a class='hb-btn hb-btn-ghost' href='#'>查看演示</a></div></div></section>",
    "css": ".hb-hero{padding:96px 24px 72px;text-align:center;background:radial-gradient(60% 60% at 50% 0%,rgba(99,102,241,.16),transparent 70%)}.hb-hero-inner{max-width:860px;margin:0 auto}.hb-hero-badge{display:inline-block;padding:6px 14px;border-radius:999px;background:rgba(99,102,241,.12);color:#4f46e5;font-size:13px;font-weight:600}.hb-hero-title{margin:22px 0 18px;font-size:clamp(34px,6vw,68px);line-height:1.12;font-weight:800;letter-spacing:-.03em;color:#0f172a}.hb-hero-sub{margin:0 auto 32px;max-width:600px;font-size:17px;line-height:1.7;color:#475569}.hb-hero-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}.hb-btn{display:inline-block;padding:13px 26px;border-radius:999px;font-size:15px;font-weight:600;text-decoration:none;transition:transform .2s,box-shadow .2s}.hb-btn:hover{transform:translateY(-2px)}.hb-btn-primary{background:#6366f1;color:#fff;box-shadow:0 10px 24px rgba(99,102,241,.32)}.hb-btn-ghost{background:#fff;color:#0f172a;border:1px solid rgba(15,23,42,.12)}",
    "js": ""
  },

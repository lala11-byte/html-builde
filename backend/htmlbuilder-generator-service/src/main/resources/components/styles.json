[
  {
    "id": "style-button-glow",
    "name": "按钮 · 霓虹渐变",
    "category": "美学配方",
    "kind": "style",
    "scope": "target",
    "description": "给选中元素加渐变主色、柔和投影与悬浮抬升，只改外观不换内容，适合主按钮。",
    "html": "<button class='hb-prev' type='button'>立即开始</button>",
    "css": "&{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 28px;border:0;border-radius:999px;background:linear-gradient(120deg,#6366f1,#8b5cf6 55%,#0ea5e9);color:#fff;font-size:15px;font-weight:600;letter-spacing:.01em;cursor:pointer;box-shadow:0 10px 24px rgba(99,102,241,.35);transition:transform .22s ease,box-shadow .22s ease,filter .22s ease}&:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(99,102,241,.42);filter:saturate(1.08)}&:active{transform:translateY(0);box-shadow:0 6px 16px rgba(99,102,241,.3)}&:focus-visible{outline:2px solid #a5b4fc;outline-offset:3px}",
    "js": ""
  },
  {
    "id": "style-card-elevated",
    "name": "卡片 · 悬浮玻璃",
    "category": "美学配方",
    "kind": "style",
    "scope": "target",
    "description": "半透明背景 + 柔和多层阴影，悬停轻微上浮，适合卡片、面板、列表项。",
    "html": "<div class='hb-prev'><strong style='display:block;margin-bottom:6px'>极速生成</strong><span style='color:#64748b;font-size:13px'>从需求到可运行网站</span></div>",
    "css": "&{position:relative;padding:26px;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.96),rgba(248,250,252,.92));border:1px solid rgba(15,23,42,.08);box-shadow:0 1px 2px rgba(15,23,42,.04),0 12px 32px -12px rgba(15,23,42,.12);backdrop-filter:blur(8px);transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}&:hover{transform:translateY(-4px);border-color:rgba(99,102,241,.28);box-shadow:0 22px 48px -16px rgba(79,70,229,.28)}",
    "js": ""
  },
  {
    "id": "style-title-gradient",
    "name": "标题 · 渐变文字",
    "category": "美学配方",
    "kind": "style",
    "scope": "target",
    "description": "深色到主色的渐变字面，收紧字距，适合大标题与数字。",
    "html": "<h2 class='hb-prev' style='margin:0'>用一句话生成完整网站</h2>",
    "css": "&{background:linear-gradient(96deg,#0f172a,#4f46e5 48%,#0ea5e9);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;letter-spacing:-.02em;line-height:1.18}",
    "js": ""
  },
  {
    "id": "style-input-soft",
    "name": "输入框 · 柔和描边",
    "category": "美学配方",
    "kind": "style",
    "scope": "target",
    "description": "统一圆角、描边与聚焦光环，适合 input / textarea / select。",
    "html": "<input class='hb-prev' placeholder='输入你的邮箱' />",
    "css": "&{width:100%;padding:13px 16px;border-radius:12px;border:1px solid rgba(15,23,42,.12);background:#fff;color:#0f172a;font-size:15px;line-height:1.5;transition:border-color .2s ease,box-shadow .2s ease,background .2s ease}&::placeholder{color:#94a3b8}&:hover{border-color:rgba(15,23,42,.2)}&:focus{outline:none;border-color:#6366f1;box-shadow:0 0 0 4px rgba(99,102,241,.14);background:#fff}",
    "js": ""
  },
  {
    "id": "style-link-underline",
    "name": "链接 · 动效下划线",
    "category": "美学配方",
    "kind": "style",
    "scope": "target",
    "description": "主色文字，悬停时下划线从左展开，适合导航与正文链接。",
    "html": "<a class='hb-prev' href='#'>查看产品文档</a>",
    "css": "&{position:relative;display:inline-block;color:#4f46e5;text-decoration:none;font-weight:500;transition:color .2s ease}&::after{content:'';position:absolute;left:0;bottom:-2px;width:100%;height:1.5px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .25s ease}&:hover::after{transform:scaleX(1)}",
    "js": ""
  },
  {
    "id": "style-image-frame",
    "name": "图片 · 圆角相框",
    "category": "美学配方",
    "kind": "style",
    "scope": "target",
    "description": "统一圆角、遮蔽与柔和投影，悬停轻微放大，适合图片与头像。",
    "html": "<div class='hb-prev' style='width:100%;height:96px;background:linear-gradient(120deg,#c7d2fe,#a5f3fc 60%,#bfdbfe);border-radius:16px'></div>",
    "css": "&{display:block;max-width:100%;height:auto;border-radius:16px;box-shadow:0 18px 40px -18px rgba(15,23,42,.35);transition:transform .3s ease,box-shadow .3s ease;object-fit:cover}&:hover{transform:scale(1.015);box-shadow:0 24px 52px -20px rgba(15,23,42,.4)}",
    "js": ""
  }
]